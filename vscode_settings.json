{
  "workbench.sideBar.location": "right",
  "workbench.iconTheme": "vscode-icons",
  "editor.fontFamily": "Monaco, 'Courier New', monospace",
  "terminal.integrated.fontFamily": "Monaco, 'Courier New', monospace",
  "debug.console.fontFamily": "Monaco, 'Courier New', monospace",
  "debug.toolBarLocation": "docked",
  "editor.fontSize": 12,
  "terminal.integrated.fontSize": 12,
  "debug.console.fontSize": 12,
  "explorer.confirmDelete": false,
  "editor.accessibilitySupport": "off",
  "explorer.confirmDragAndDrop": false,
  "files.autoSave": "onFocusChange",
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
  },
  "isort.args": [
    "--profile",
    "black"
  ],
  "isort.check": true,
  "black-formatter.importStrategy": "useBundled",
  "autoDocstring.docstringFormat": "google-notypes",
  "scm.showOutgoingChanges": "always",
  "gitlens.graph.layout": "editor",
  "git-graph.commitDetailsView.fileView.type": "File List",
  "scm.experimental.showHistoryGraph": true,
  "workbench.startupEditor": "none",
}
